# Optional local development settings. Railway can run without adding these variables.
PORT=3000
DATABASE_PATH=./data/ban-shar.db
PROVIDER_DOCUMENTS_PATH=./data/provider-documents
# Optional overrides; if omitted, the first admin is generated automatically.
# ADMIN_NAME=مدير البنشر الذكي
# ADMIN_EMAIL=admin@albanshar.app
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# Optional external JWT signing key; if omitted, a persistent key is generated in the database.
# JWT_SECRET=generate-a-long-random-secret-at-least-32-characters
NODE_ENV=development
