# Railway supplies PORT automatically. Set DATABASE_URL to a Railway PostgreSQL database.
DATABASE_URL=
JWT_SECRET=
APP_BASE_URL=
NODE_ENV=development

# Used only to create the first super-admin if no admin exists. Change these before deployment.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=مدير النظام

# SMS/OTP is intentionally disabled until a provider is configured. In development only,
# OTP codes are printed to the server console. Never enable development OTP in production.
OTP_MODE=console
OTP_TTL_SECONDS=300
UPLOAD_MAX_MB=8
# Optional routing API URL; default uses OSRM demo endpoint (not intended for high-volume production).
ROUTING_BASE_URL=https://router.project-osrm.org
# Optional production SMS delivery via Twilio Messaging API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
